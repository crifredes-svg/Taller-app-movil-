# ==========================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================
PORT=9000

# ==========================================
# BASE DE DATOS MYSQL EN 1PANEL
# ==========================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=redcuidadora_app
DB_PASSWORD=
DB_NAME=redcuidadora_db

# Genera uno distinto y aleatorio por entorno (mínimo 32 bytes).
JWT_SECRET=

# ==========================================
# CORREO PARA CÓDIGOS DE VERIFICACIÓN (SMTP)
# ==========================================
# Gmail: activa la verificación en dos pasos y crea una "contraseña de
# aplicación"; úsala en SMTP_PASSWORD (no la clave normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Opcional: remitente visible. Si queda vacío se usa SMTP_USER.
SMTP_FROM=